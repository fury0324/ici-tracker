# Base URL of the server/ backend's API.
# Defaults to http://localhost:4000/api if unset, which works for web preview
# and the iOS simulator only. For a physical device via Expo Go, or an
# Android emulator, set this to your machine's LAN IP instead, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.23:4000/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api
