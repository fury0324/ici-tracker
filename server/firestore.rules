rules_version = '2';

// This backend accesses Firestore exclusively through the Admin SDK, which
// bypasses these rules. They only matter if a client app is ever pointed at
// Firestore directly — until then, deny all direct client access by default.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
